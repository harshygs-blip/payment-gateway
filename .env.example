# Server Configuration
PORT=3000
NODE_ENV=development

# Merchant UPI Details
MERCHANT_UPI_VPA=yourname@fam
MERCHANT_NAME=Personal Gateway

# Order Expiry Settings (in minutes)
ORDER_EXPIRY_MINUTES=5

# Email / IMAP Configuration (for FamPay / Bank Alert Emails)
# To use Gmail: Enable 2-Step Verification in Google Account -> Generate 'App Password'
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your_email@gmail.com
IMAP_PASS=your_16_char_app_password
IMAP_MAILBOX=INBOX
# Sender filter (comma separated, leave empty or set to fampay alert addresses)
IMAP_SENDER_FILTER=alerts@fampay.in,no-reply@fampay.in,fampay

# Webhook secret / Admin API key (optional protection)
ADMIN_SECRET_KEY=admin123
